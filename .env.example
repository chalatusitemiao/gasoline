# 应用运行使用的 PostgreSQL 连接串，部署时可填写数据库服务商提供的连接池地址。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gasoline
# 可选的 PostgreSQL 直连地址，供 Drizzle 执行迁移。留空时使用 DATABASE_URL。
# DATABASE_URL_UNPOOLED=
# 用户实际访问站点的源地址，包含协议、域名和可选端口。例如 http://localhost:3000。
BETTER_AUTH_URL=http://localhost:3000
# Better Auth 使用的随机密钥，至少 32 个字符，可用 openssl rand -base64 32 生成。
BETTER_AUTH_SECRET=
# 唯一后台账号的用户名，仅在服务端使用。
FUEL_LOGIN_USERNAME=admin
# 后台账号的登录密码，仅在服务端使用。
FUEL_LOGIN_PASSWORD=
# 业务日期、月份和删除日志保留期使用的 IANA 时区，默认 Asia/Shanghai。
FUEL_TIME_ZONE=Asia/Shanghai
# 计算单车油耗基线时，最多取最近多少条有效且未标记异常的油耗记录。填 2–100 的整数，默认 5。
FUEL_BASELINE_SAMPLES=5
# 百公里油耗超过基线乘以此倍数时标记为偏高。填 1–100，可填小数，默认 1.3。
FUEL_ANOMALY_MULTIPLIER=1.3
