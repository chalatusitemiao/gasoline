{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gasoline",
  "version": "0.1.0",
  "identifier": "com.ruiange.gasoline",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "车辆监控",
        "width": 1360,
        "height": 900,
        "minWidth": 720,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
